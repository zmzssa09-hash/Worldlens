# 내 컴퓨터에서 미리 볼 때 쓰는 설정 (npm start)
# 이 파일을 복사해 이름을 .env 로 바꾸고, 쓸 줄 맨 앞의 # 을 지우세요.
# 공개 사이트(GitHub Actions)에는 같은 값을 GitHub 저장소의 Settings → Secrets and variables → Actions 에 넣어요.

# AI 분석·번역을 켜려면 (키 발급: https://platform.claude.com → API Keys)
# ANTHROPIC_API_KEY=sk-ant-...

# (선택) 사용할 모델. 기본값 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5 또는 claude-haiku-5-5
# WORLDLENS_MODEL=claude-opus-5-5

# (선택) 분석 깊이: low | medium | high
# WORLDLENS_EFFORT=medium

# (선택) AI 비용 관리: 한 번 갱신할 때 분석할 최대 사건 수, 하루 최대 분석 횟수
# WORLDLENS_MAX_AI_EVENTS=4
# WORLDLENS_MAX_AI_PER_DAY=120

# (선택) 미리 보기 포트
# PORT=3000

# (선택) 사이트 아래쪽·약관에 보일 정보 (비워 두면 표시하지 않아요)
# WORLDLENS_CONTACT_EMAIL=문의받을@이메일
# WORLDLENS_BUSINESS_NAME=상호
# WORLDLENS_BUSINESS_OWNER=대표자 이름
# WORLDLENS_BUSINESS_REG_NO=000-00-00000
# WORLDLENS_MAIL_ORDER_NO=제0000-서울00-0000호
# WORLDLENS_BUSINESS_ADDRESS=사업장 주소
