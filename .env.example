# AI 분석을 켜려면 아래 줄 맨 앞의 # 을 지우고 키를 넣은 뒤, 파일 이름을 .env 로 바꾸세요.
# 키 발급: https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=sk-ant-...

# (선택) 사용할 모델. 기본값 claude-opus-5-5. 비용을 줄이려면 claude-sonnet-5-5 또는 claude-haiku-5-5
# WORLDLENS_MODEL=claude-opus-5-5

# (선택) 분석 깊이: low | medium | high
# WORLDLENS_EFFORT=medium

# (선택) 한 번에 AI로 분석할 최대 사건 수 (비용 관리)
# WORLDLENS_MAX_AI_EVENTS=8

# (선택) 포트
# PORT=3000

# ── 회원·구독 ──
# 무료 체험 일수, 월 구독료(원)
# WORLDLENS_TRIAL_DAYS=7
# WORLDLENS_PRICE=4900

# 토스페이먼츠 (개발자센터 https://developers.tosspayments.com/my/api-keys 에서 확인)
# 자동결제(빌링)는 'API 개별 연동 키'(test_ck_/test_sk_)를 써요. 위젯 키(test_gck_)는 안 돼요.
# 두 키가 모두 있으면 토스 자동결제로, 없으면 '개발용 테스트 결제'로 동작해요.
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# 실제 서비스에서는 개발용 테스트 결제를 반드시 끄세요
# WORLDLENS_DEV_BILLING=off

# 운영자 이메일: 이 계정으로 로그인했을 때만 '새로고침'(즉시 갱신) 버튼이 보여요.
# 비워 두면 이 컴퓨터(localhost)에서 접속할 때만 보여요.
# WORLDLENS_ADMIN_EMAIL=운영자@이메일.com

# ── 사이트 아래쪽·약관에 보일 운영자 정보 (비워 두면 '준비 중'으로 보여요) ──
# WORLDLENS_CONTACT_EMAIL=문의받을@이메일
# WORLDLENS_BUSINESS_NAME=상호
# WORLDLENS_BUSINESS_OWNER=대표자 이름
# WORLDLENS_BUSINESS_REG_NO=000-00-00000
# WORLDLENS_MAIL_ORDER_NO=제0000-서울00-0000호
# WORLDLENS_BUSINESS_ADDRESS=사업장 주소
